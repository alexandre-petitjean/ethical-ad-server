# Environment variables for the Ethical Ad Server on Clever Cloud.
#
# Deploy three Docker applications from this repository, all built from the
# root Dockerfile, and link the same add-ons to each of them:
#
#   ethical-ad-server-web     CC_RUN_COMMAND="/app/deploy/entrypoint.sh web"
#   ethical-ad-server-worker  CC_RUN_COMMAND="/app/deploy/entrypoint.sh worker"
#   ethical-ad-server-beat    CC_RUN_COMMAND="/app/deploy/entrypoint.sh beat"
#
# Beat must stay at exactly one instance, with autoscaling disabled: two beat
# processes means every scheduled task fires twice.
#
# Add-ons to create and link: PostgreSQL, Redis, Cellar (S3).
# Their credentials (POSTGRESQL_ADDON_*, REDIS_*, CELLAR_ADDON_*) are injected
# automatically once linked, and deploy/entrypoint.sh maps them onto the
# DATABASE_URL / REDIS_URL / AWS_* names Django expects. Do not copy them here.
#
# Import with:  clever env import < deploy/clevercloud.env.sample


# Django core
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=""
# Comma-separated, no scheme. Include every domain serving the ad server.
ALLOWED_HOSTS="ads.example.com"
# Enables HSTS, secure cookies and the HTTP -> HTTPS redirect. Keep this on.
ADSERVER_HTTPS="true"
# Optional: redirect any other host to this one
#ENFORCE_HOST="ads.example.com"

# Email. Defaults to SendGrid through django-anymail. Before a provider is
# chosen, point EMAIL_BACKEND at the console backend: mail is written to the
# application logs instead of raising on every invitation or password reset.
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
#EMAIL_BACKEND="anymail.backends.sendgrid.EmailBackend"
#SENDGRID_API_KEY=""


# Object storage for advertiser-uploaded images (Cellar)
# ---------------------------------------------------------------------------
# Instance disks are ephemeral, so uploaded ad images MUST live in Cellar or
# they disappear on the next deploy. Create the buckets in the Cellar add-on
# first; the add-on itself does not provide bucket names.
DEFAULT_FILE_STORAGE="config.storage.S3CDNFileStorage"
DATA_STORAGE="config.storage.S3DataStorage"
AWS_STORAGE_BUCKET_NAME="ethicalads-media"
AWS_DATA_STORAGE_BUCKET_NAME="ethicalads-data"
# Cellar region; the endpoint and path-style addressing are set by the entrypoint
AWS_S3_REGION_NAME="us-west-1"
# Public base URL for media. Must be fully qualified: it is embedded in the ad
# HTML served to publishers.
MEDIA_URL="https://ethicalads-media.cellar-c2.services.clever-cloud.com/"
# Optional: serve media through a CDN or custom domain instead
#DEFAULT_FILE_STORAGE_HOSTNAME="media.example.com"


# IP geolocation and proxy detection
# ---------------------------------------------------------------------------
# The databases are ~70MB and are downloaded at boot rather than baked into the
# image. Without them the server still serves ads, but every geo-targeted
# flight silently matches nothing.
# Set to false until a MaxMind licence key is available.
GEOIP_DOWNLOAD_ON_BOOT="false"
GEOIP_GEOLITE2_PATH="/app/geoip"
# Free MaxMind account: https://www.maxmind.com/en/geolite2/signup
#MAXMIND_LICENSE_KEY=""
# Optional, for proxy/VPN detection
#IP2LOCATION_TOKEN=""


# Migrations
# ---------------------------------------------------------------------------
# Leave this off on all three applications and run migrations from a dedicated
# Clever Task instead:  clever env set CC_RUN_COMMAND "/app/deploy/entrypoint.sh migrate"
# Several instances booting at once would otherwise race each other.
#RUN_MIGRATIONS="false"


# Process tuning
# ---------------------------------------------------------------------------
# web
#GUNICORN_WORKERS="3"
# The image ships gunicorn[gevent]; switch only after load testing
#GUNICORN_WORKER_CLASS="sync"
#GUNICORN_TIMEOUT="30"
# worker
#CELERY_CONCURRENCY="2"
#CELERY_LOG_LEVEL="INFO"


# Optional integrations
# ---------------------------------------------------------------------------
#SENTRY_DSN=""
#NEW_RELIC_LICENSE_KEY=""
#SLACK_TOKEN=""
#STRIPE_SECRET_KEY=""
#STRIPE_CONNECT_CLIENT_ID=""
#STRIPE_WEBHOOK_SECRET=""
# Metabase dashboards are embedded via signed JWTs; keep this off until a
# Metabase instance is deployed and reachable.
METABASE_ENABLED="false"
